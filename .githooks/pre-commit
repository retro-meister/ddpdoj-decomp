#!/bin/sh
# Automatically record progress and re-render charts whenever splat.yaml or progress-history.json is committed.
staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | grep -qE '^config/[^/]+/splat\.yaml$'; then
    uv run tools/progress.py --record --plot >/dev/null || { echo "pre-commit: progress record/plot failed" >&2; exit 1; }
    git add config/progress-history.json docs/progress-*.svg
elif printf '%s\n' "$staged" | grep -qx "config/progress-history.json"; then
    uv run tools/progress.py --plot >/dev/null || { echo "pre-commit: progress chart failed" >&2; exit 1; }
    git add docs/progress-*.svg
fi
